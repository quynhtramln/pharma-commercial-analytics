	/// Number of products in the Declining momentum tier (90-day sales growth below the 33rd percentile, to 29 Jun 2026).
	measure 'Declining Products' =
			
			CALCULATE(COUNTROWS(tbl_product_momentum), tbl_product_momentum[Momentum Tier] = "Declining")
		formatString: 0
		displayFolder: 1. Sales
