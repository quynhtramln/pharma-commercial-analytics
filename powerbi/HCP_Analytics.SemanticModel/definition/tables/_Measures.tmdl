	/// Font colour for the Momentum tier column: blue for Rising, red for Declining, grey otherwise.
	measure 'Momentum Tier Color' =
			
			SWITCH(
			    [Momentum Tier Label],
			    "Rising", "#1565C0",
			    "Declining", "#C62828",
			    "#546E7A"
			)
		isHidden
