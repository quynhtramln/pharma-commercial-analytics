	/// Number of products in the Rising momentum tier (90-day sales growth above the 67th percentile, to 29 Jun 2026).
	measure 'Rising Products' =
			
			CALCULATE(COUNTROWS(tbl_product_momentum), tbl_product_momentum[Momentum Tier] = "Rising")
		formatString: 0
