		changedProperty = IsHidden

	/// Font colour for the 90-day growth card: green when sales grew vs the previous 90 days, red when they fell, grey when blank or zero.
	measure 'Growth 90D Color' =
			
			VAR g = [Sales 90D Growth %]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(g), "#546E7A",
			        g > 0, "#2E7D32",
			        g < 0, "#C62828",
			        "#546E7A"
			    )
		displayFolder: 1. Sales
		lineageTag: 4407b3c5-0ac2-4b06-8a34-3de34de1c196

	/// Font colour for the month-on-month growth card: green when the latest month grew vs the previous month, red when it fell, grey when blank or zero.
	measure 'MoM Growth Color' =
			
			VAR g = [MoM Growth % (Latest Month)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(g), "#546E7A",
			        g > 0, "#2E7D32",
			        g < 0, "#C62828",
			        "#546E7A"
			    )
		isHidden
		displayFolder: 1. Sales
		lineageTag: 20e36ecc-b8ec-4c14-b5f9-35f682e29022

		changedProperty = IsHidden

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

